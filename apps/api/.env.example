# Env vars are passed by the shell (dotenv is NOT installed/used). Every
# default below preserves the current demo behaviour untouched — copy what
# you need into your shell/CI environment, nothing here is required to run
# the Friday demo.

# ---- Auth (src/auth) ------------------------------------------------------
# Off by default: every request is allowed, and a demo user (all roles,
# or the roles in X-Demo-Peran) is injected. NEVER set this to true without
# also configuring AUTH_JWKS_URL (or a real AUTH_DEV_SECRET) below.
AUTH_ENABLED=false
# OIDC JWKS endpoint (e.g. Entra ID: https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys).
# When set, bearer tokens are verified against it instead of AUTH_DEV_SECRET.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# HS256 secret for local/dev tokens, used only when AUTH_JWKS_URL is empty. Change before any real use.
AUTH_DEV_SECRET=ubah-rahasia-ini-sebelum-produksi

# ---- Database (src/config, src/database) ----------------------------------
# better-sqlite3 (default, demo) or postgres (prepared, not wired to a real instance here).
DB_TYPE=better-sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Postgres: database name. Sqlite: optional override of the database FILE PATH
# (or ':memory:'), used by tests/tooling — leave empty to use the default
# apps/api/data/demo.sqlite.
DB_NAME=
# Sqlite demo default: true (auto schema sync, no migrations needed). Ignored
# for postgres, which is always false — use `npm run migration:run` instead.
DB_SYNCHRONIZE=true

# ---- Photo storage (src/photos) --------------------------------------------
# local (default, current behaviour) or s3 (stubbed — see src/photos/s3-storage.ts).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ---- Retention / PDP (src/pdp) ---------------------------------------------
# Days of server-side data retention before RetentionService deletes a record. Default: 730 (2 years).
RETENTION_SERVER_DAYS=730
# Off by default — the demo never auto-deletes data. When true, a daily cron job runs the retention sweep.
RETENTION_CRON_ENABLED=false

# ---- Integrations (src/integrations) ---------------------------------------
# Empty = disabled (default). When set, a JSON webhook fires when an inspection lands with STOP_OPERASI.
INTEGRATION_WEBHOOK_URL=
