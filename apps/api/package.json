{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:reset": "node -e \"const fs=require('fs');fs.rmSync('data/demo.sqlite',{force:true});fs.rmSync('uploads',{recursive:true,force:true});console.log('reset ok');\"",
    "test": "jest",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^11.0.0",
    "@p2h/shared": "*",
    "better-sqlite3": "^12.11.1",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  }
}
